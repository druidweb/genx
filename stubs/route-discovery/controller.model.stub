<?php

{{ strictTypes }}
namespace {{ namespace }};

use {{ namespacedModel }};
use {{ namespacedRequests }};
use Spatie\RouteDiscovery\Attributes\Route;

{{ finalClass }} {{ class }}
{
  /**
   * Display a listing of the resource.
   */
  #[Route(fullUri: '{{ route }}', name: '{{ routeName }}.index', middleware: [{{ middleware }}])]
  public function index() {}

  /**
   * Show the form for creating a new resource.
   */
  #[Route(fullUri: '{{ route }}/create', name: '{{ routeName }}.create', middleware: [{{ middleware }}])]
  public function create() {}

  /**
   * Store a newly created resource in storage.
   */
  #[Route(fullUri: '{{ route }}', name: '{{ routeName }}.store', middleware: [{{ middleware }}])]
  public function store({{ storeRequest }} $request) {}

  /**
   * Display the specified resource.
   */
  #[Route(fullUri: '{{ route }}/{{{ modelVariable }}}', name: '{{ routeName }}.show', middleware: [{{ middleware }}])]
  public function show({{ model }} ${{ modelVariable }}) {}

  /**
   * Show the form for editing the specified resource.
   */
  #[Route(fullUri: '{{ route }}/{{{ modelVariable }}}/edit', name: '{{ routeName }}.edit', middleware: [{{ middleware }}])]
  public function edit({{ model }} ${{ modelVariable }}) {}

  /**
   * Update the specified resource in storage.
   */
  #[Route(fullUri: '{{ route }}/{{{ modelVariable }}}', name: '{{ routeName }}.update', middleware: [{{ middleware }}])]
  public function update({{ updateRequest }} $request, {{ model }} ${{ modelVariable }}) {}

  /**
   * Remove the specified resource from storage.
   */
  #[Route(fullUri: '{{ route }}/{{{ modelVariable }}}', name: '{{ routeName }}.destroy', middleware: [{{ middleware }}])]
  public function destroy({{ model }} ${{ modelVariable }}) {}
}
