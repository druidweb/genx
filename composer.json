{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "druidweb/genx",
  "description": "A console generator/stubs package for the Druid Laravel starter kit.",
  "keywords": [
    "laravel",
    "druid",
    "stubs",
    "generators",
    "zen"
  ],
  "authors": [
    {
      "name": "Jetstream Labs",
      "email": "hello@jetstreamlabs.com"
    }
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.8.0",
    "nesbot/carbon": "^3.11.4",
    "symfony/console": "^7.4.9",
    "symfony/http-kernel": "^7.4.8",
    "symfony/polyfill-php84": "^1.37.0"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.3.0",
    "larastan/larastan": "^3.9.6",
    "orchestra/testbench": "^11.1.0",
    "pestphp/pest": "^4.7.0",
    "pestphp/pest-plugin-laravel": "^4.1.0",
    "pestphp/pest-plugin-type-coverage": "^4.0.4",
    "rector/rector": "^2.4.2",
    "spatie/laravel-route-discovery": "^1.6.0",
    "zenphp/fixr": "^1.0.4",
    "zenphp/modulr": "^1.3.0"
  },
  "autoload": {
    "psr-4": {
      "Druid\\Genx\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": [
      "./vendor/bin/rector",
      "./vendor/bin/fixr"
    ],
    "test:types": "./vendor/bin/pest --type-coverage --parallel --min=100",
    "test:lint": [
      "./vendor/bin/rector --dry-run",
      "./vendor/bin/fixr --test"
    ],
    "test:feat": "./vendor/bin/pest",
    "test:coverage": [
      "./vendor/bin/pest --coverage --min=100.0 --coverage-clover=coverage.xml",
      "@php bin/clean-coverage"
    ],
    "test:static": "./vendor/bin/phpstan analyze",
    "test": [
      "@test:types",
      "@test:static",
      "@test:lint",
      "@test:feat"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.x-dev"
    },
    "laravel": {
      "providers": [
        "Druid\\Genx\\GenxServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
